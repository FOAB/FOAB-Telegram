{
  "name": "foab-telegram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --dir webapp build",
    "dev": "pnpm build && node --env-file-if-exists=.env dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm --dir webapp typecheck",
    "db:provision:local": "node --env-file-if-exists=.env scripts/db/provision-local.ts",
    "db:generate": "node --env-file-if-exists=.env.database node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.database node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "db:migrate:test": "node --env-file-if-exists=.env.database node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.test.config.ts",
    "security:secrets": "pwsh -NoProfile -File scripts/security/Invoke-SecurityChecks.ps1 -SelfTest"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.1",
    "@fastify/static": "10.1.4",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "grammy": "1.46.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
